{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shot.schema.json",
  "title": "Shot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shot_id",
    "purpose",
    "duration_s",
    "start_state",
    "action",
    "end_state",
    "camera",
    "performance_requirement",
    "reference_requirement",
    "generation_status"
  ],
  "properties": {
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "start_state": {
      "type": "object"
    },
    "action": {
      "type": "object",
      "minProperties": 1
    },
    "end_state": {
      "type": "object"
    },
    "performance_requirement": {
      "enum": [
        "required",
        "not_applicable"
      ]
    },
    "reference_requirement": {
      "enum": [
        "required",
        "not_applicable"
      ]
    },
    "performance": {
      "$ref": "performance.schema.json"
    },
    "camera": {
      "$ref": "camera.schema.json"
    },
    "motion": {
      "type": "object"
    },
    "lighting": {
      "type": "object"
    },
    "sound": {
      "type": "object"
    },
    "continuity": {
      "$ref": "continuity.schema.json"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "complexity_score": {
      "type": "number",
      "minimum": 0
    },
    "generation_status": {
      "enum": [
        "DRAFT",
        "NOT_READY",
        "READY",
        "GENERATED",
        "APPROVED",
        "REJECTED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "performance_requirement": {
            "const": "required"
          }
        },
        "required": [
          "performance_requirement"
        ]
      },
      "then": {
        "required": [
          "performance"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reference_requirement": {
            "const": "required"
          }
        },
        "required": [
          "reference_requirement"
        ]
      },
      "then": {
        "required": [
          "references"
        ],
        "properties": {
          "references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generation_status": {
            "enum": [
              "READY",
              "GENERATED",
              "APPROVED"
            ]
          }
        },
        "required": [
          "generation_status"
        ]
      },
      "then": {
        "required": [
          "motion",
          "lighting",
          "continuity",
          "constraints",
          "complexity_score"
        ]
      }
    }
  ]
}
