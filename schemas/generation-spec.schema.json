{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-spec.schema.json",
  "title": "Generation Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_target",
    "shot_id",
    "mode",
    "prompt",
    "duration_s",
    "aspect_ratio",
    "negative_constraints",
    "generation_status"
  ],
  "properties": {
    "model_target": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string"
    },
    "capability_profile_verified_at": {
      "type": "string",
      "format": "date"
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "text_to_video",
        "image_to_video",
        "reference_to_video",
        "first_last_frame",
        "motion_transfer",
        "video_edit",
        "extend",
        "composite",
        "traditional",
        "other"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "aspect_ratio": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "resolution": {
      "type": "string"
    },
    "audio_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generation_status": {
      "enum": [
        "DRAFT",
        "READY",
        "GENERATED",
        "APPROVED",
        "REJECTED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "image_to_video",
              "reference_to_video",
              "motion_transfer",
              "video_edit",
              "extend"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "references"
        ],
        "properties": {
          "references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "first_last_frame"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "references"
        ],
        "properties": {
          "references": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
